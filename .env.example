NODE_ENV=development
HOST=127.0.0.1
PORT=3001
API_PREFIX=/api/v1

# Use separate databases for development and integration tests.
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/lidkep
TEST_DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/lidkep_test

CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
JSON_BODY_LIMIT=1mb
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Demo routes are a temporary frontend compatibility layer and must stay off in production.
ENABLE_DEMO_ROUTES=true
