NODE_ENV=development
HOST=127.0.0.1
PORT=3001
API_PREFIX=/api/v1

# Use separate databases for development and integration tests.
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/lidkep
TEST_DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/lidkep_test

CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
JSON_BODY_LIMIT=1mb
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Legacy sample-data routes must stay disabled.
ENABLE_DEMO_ROUTES=false
SESSION_COOKIE_NAME=lidkep_session
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24
COOKIE_SECURE=false

INITIAL_ADMIN_EMAIL=admin@lidkep.rw
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_INNOVATOR_EMAIL=innovator@lidkep.rw
INITIAL_INNOVATOR_PASSWORD=replace-with-a-strong-password
