    {"id":"solar-cold-chain","slug":"solar-cold-chain-for-small-farms","title":"Solar cold chain for small farms","summary":"A modular cold room helping cooperatives preserve harvests using locally serviceable solar technology.","problem":"Smallholder farmers lose up to a third of perishable produce before it reaches market because reliable cold storage is unavailable near farms.","solution":"A cooperative-owned, pay-per-crate cold room with solar thermal storage, remote temperature monitoring and locally trained maintenance teams.","beneficiaries":"Potato, vegetable and fruit cooperatives serving 2,400 smallholder farmers.","sector":"Climate & Energy","category":"Product innovation","district":"Musanze","maturity":"M4 Pilot","status":"PUBLISHED","impact":"Food security","supportNeeded":"Distribution partners","owner":"Keza Nyirabazungu","organization":"CoolHarvest Cooperative","publishedAt":"2026-06-14","version":3,"completion":100,"views":4821,"saves":126,"imageTone":"mint","evidence":["Pilot performance report.pdf","Cold-room installation photos"],"metrics":[{"value":"31%","label":"post-harvest loss reduced"},{"value":"2,400","label":"farmers in reach"},{"value":"18 t","label":"monthly capacity"}],"milestones":[{"title":"Musanze pilot launched","date":"Jan 2026","status":"COMPLETED"},{"title":"Cooperative training","date":"Apr 2026","status":"COMPLETED"},{"title":"Northern Province expansion","date":"Sep 2026","status":"IN_PROGRESS"}]},
    {"id":"maternal-care","slug":"maternal-care-companion","title":"Maternal care companion","summary":"A low-bandwidth care pathway connecting expectant mothers with timely local guidance and referrals.","problem":"Pregnant women in remote communities can miss essential antenatal information and referral signals between clinic visits.","solution":"A USSD and voice-based maternal support pathway synchronized with community health worker follow-up.","beneficiaries":"Expectant mothers, community health workers and rural health centres.","sector":"Health","category":"Service innovation","district":"Kicukiro","maturity":"M3 Prototype","status":"PUBLISHED","impact":"Health access","supportNeeded":"Pilot sites","owner":"Mukamana Diane","organization":"Ubuzima Link","publishedAt":"2026-05-29","version":2,"completion":100,"views":3260,"saves":91,"imageTone":"amber","evidence":["Clinical pathway overview.pdf"],"metrics":[{"value":"640","label":"mothers onboarded"},{"value":"94%","label":"message delivery"},{"value":"12","label":"health centres"}],"milestones":[{"title":"Clinical review completed","date":"Feb 2026","status":"COMPLETED"},{"title":"Kicukiro pilot","date":"Jul 2026","status":"IN_PROGRESS"}]},
    {"id":"circular-bricks","slug":"circular-bricks-from-agri-waste","title":"Circular bricks from agri-waste","summary":"Durable construction blocks produced from agricultural waste and locally sourced binders.","problem":"Agricultural residues are often burned or dumped while affordable, lower-carbon construction materials remain scarce.","solution":"A verified production process converting rice husks and other residues into lightweight masonry units.","beneficiaries":"Small contractors, young manufacturers and climate-conscious housing projects.","sector":"Manufacturing","category":"Process innovation","district":"Huye","maturity":"M5 Operational","status":"PUBLISHED","impact":"Green jobs","supportNeeded":"Growth capital","owner":"Jean Claude Murenzi","organization":"ReBuild Rwanda","publishedAt":"2026-04-18","version":4,"completion":100,"views":5910,"saves":203,"imageTone":"blue","evidence":["Material strength certificate.pdf","Factory overview"],"metrics":[{"value":"42","label":"green jobs"},{"value":"28%","label":"lower embodied carbon"},{"value":"8,200","label":"blocks per month"}],"milestones":[{"title":"Standards certification","date":"Nov 2025","status":"COMPLETED"},{"title":"Second production line","date":"Oct 2026","status":"PLANNED"}]},
    {"id":"smart-irrigation","slug":"smart-irrigation-valve","title":"Smart irrigation valve","summary":"A rugged sensor-guided valve that helps farmer groups use water only when crops need it.","problem":"Manual irrigation schedules waste scarce water and labour.","solution":"A solar-powered soil-moisture controller with offline-first field configuration.","beneficiaries":"Water user associations and horticulture farmers.","sector":"Agriculture","category":"Product innovation","district":"Nyagatare","maturity":"M3 Prototype","status":"UNDER_REVIEW","impact":"Climate resilience","supportNeeded":"Technical validation","owner":"Keza Nyirabazungu","organization":"CoolHarvest Cooperative","publishedAt":"","version":1,"completion":100,"views":0,"saves":0,"imageTone":"sage","evidence":["Prototype test notes.pdf"],"metrics":[],"milestones":[{"title":"Field prototype","date":"May 2026","status":"COMPLETED"}]},
